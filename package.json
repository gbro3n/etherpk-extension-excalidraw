{
    "name": "@gbro3n/etherpk-extension-excalidraw",
    "version": "0.1.0",
    "description": "Excalidraw drawings in EtherPK documents, kept as data in the document: edited in place, in a tab or filling the window, shown as a picture on phones and published sites.",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gbro3n/etherpk-extension-excalidraw.git"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "etherpk": {
        "id": "excalidraw",
        "displayName": "Excalidraw",
        "publisher": "gbro3n",
        "minClientVersion": "0.9.5",
        "main": "./dist/main.js",
        "styles": [
            "./dist/main.css"
        ],
        "isolation": "page",
        "icons": {
            "drawing": "<path d=\"M2.5 12.5c2-3 4-5.5 6.5-7.5 1.5-1.2 3.2-1.4 4-0.6.8.8.4 2.4-.9 3.6-2.4 2.2-5.4 3.5-9.6 4.5z\"/><path d=\"M2.5 13.5h11\"/>"
        }
    },
    "scripts": {
        "build": "vite build && node scripts/copy-fonts.mjs",
        "check": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@excalidraw/excalidraw": "0.18.1",
        "react": "19.2.0",
        "react-dom": "19.2.0"
    },
    "devDependencies": {
        "@appsoftwareltd/etherpk-extension-api": "link:../etherpk-worktrees/community-extensions/packages/extension-api",
        "@playwright/test": "^1.64.0",
        "@types/node": "^25.9.9",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "fflate": "0.8.3",
        "postcss": "^8.5.6",
        "typescript": "^6.0.2",
        "vite": "^8.0.16",
        "vitest": "^4.1.11"
    },
    "packageManager": "pnpm@11.5.3"
}
